# WarcraftLogs API v2 client credentials.
# Create at: warcraftlogs.com -> Settings -> API Clients
# NEVER commit the real values. These stay server-side only.
WCL_CLIENT_ID=your-client-id
WCL_CLIENT_SECRET=your-client-secret

# Where committed Reference Profile JSON lives (relative to repo root).
WOWANALYZE_REFERENCE_DIR=data/reference
